<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!--인수 한 개 받는 생성자 호출-->
    <bean class="sample02.Member" id="m1">
        <constructor-arg value="joo"></constructor-arg>
    </bean>

    <!--인수 두 개 받는 생성자 호출-->
    <bean class="sample02.Member" id="m2">
        <constructor-arg value="king"></constructor-arg>
        <constructor-arg value="30" type="int"></constructor-arg>
    </bean>

    <bean class="sample02.Member" id="m3">
        <constructor-arg value="1234" index="1"></constructor-arg>
        <constructor-arg value="girl" index="0"></constructor-arg>
        <constructor-arg value="서울" index="3"></constructor-arg>
        <constructor-arg value="20" index="2"></constructor-arg>
    </bean>

    <bean class="sample02.MemberDAO" id="dao"/>
    <bean class="sample02.MemberService" id="service">
        <constructor-arg ref="dao"/>
        <constructor-arg ref="m3"/>
    </bean>
</beans>