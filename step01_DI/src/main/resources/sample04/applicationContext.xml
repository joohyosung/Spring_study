<!--context:xxxx 는 spring IoC 컨테이너와 관련된 설정을 간소화 해주는 역할을 한다.
애플리케이션의 빈들을 자동으로 스캔하고 빈으로 등록하는 작업을 손쉽게 해주는 역할-->
    <context:property-placeholder location="classpath:db.properties"/>

    <bean class="sample04.Student" id="s1">
        <property name="addr" value="sungnam"/>
        <property name="name" value="${name}"/>
        <property name="no" value="123"/>
        <property name="phone" value="02-111-1111"/>
    </bean>

    <bean class="sample04.Student" id="s2">
        <property name="addr" value="${addr}"/>
        <property name="name" value="${name}"/>
        <property name="no" value="${no}"/>
        <property name="phone" value="${phone}"/>
    </bean>

    <bean class="sample04.StudentDAOImpl" id="studentDao"/>

    <bean class="sample04.StudentServiceImpl" id="service">
        <property name="studentDAO" ref="studentDao"/>
    </bean>

    <bean class="sample04.StudentController" id="controller">
        <property name="student" ref="s1"/>
        <property name="studentService" ref="service"/>
    </bean>
</beans>